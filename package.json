{
  "name": "octonoesis",
  "version": "1.1.0",
  "description": "A self-calibrating terminal coding agent that learns your repo — Bun + Ink, with MCP, sub-agents, background tasks, and an evidence-gated learning loop",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PrestoOverture/octonoesis.git"
  },
  "keywords": ["coding-agent", "cli", "terminal", "ai", "llm", "bun"],
  "type": "module",
  "bin": {
    "octonoesis": "./dist/cli.js"
  },
  "files": ["dist/cli.js", "LICENSE", "README.md"],
  "scripts": {
    "cli": "bun src/cli.tsx",
    "dev": "bun src/cli.tsx",
    "build": "bun build src/cli.tsx --target=bun --outfile dist/cli.js",
    "build:bin": "bun build src/cli.tsx --compile --outfile dist/agent",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test test/unit test/integration",
    "check": "bun run typecheck && bun run lint",
    "prepublishOnly": "bun run check && bun test && bun run build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@modelcontextprotocol/sdk": "1.29.0",
    "@vscode/ripgrep": "^1.15.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.0",
    "ink": "^7.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^6.38.0",
    "react": "19",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "19",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
