{
  "name": "octonoesis",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "octonoesis": "./dist/cli.js"
  },
  "scripts": {
    "cli": "bun src/cli.tsx",
    "dev": "bun src/cli.tsx",
    "build": "bun build src/cli.tsx --target=bun --outfile dist/cli.js",
    "build:bin": "bun build src/cli.tsx --compile --outfile dist/agent",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test test/unit test/integration",
    "check": "bun run typecheck && bun run lint"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.97.1",
    "@vscode/ripgrep": "^1.15.0",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "diff": "^9.0.0",
    "fast-glob": "^3.3.0",
    "ink": "^7.0.0",
    "ink-text-input": "^6.0.0",
    "openai": "^6.38.0",
    "react": "19",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.8.0",
    "@types/diff": "^8.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "19",
    "ink-testing-library": "^4.0.0",
    "react-devtools-core": "^7.0.1",
    "typescript": "^5.9.0"
  },
  "engines": {
    "bun": ">=1.2.0"
  }
}
